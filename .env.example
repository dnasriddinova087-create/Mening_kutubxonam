# ==============================================================================
# KITOBXON AI - Environment Configuration Example
# Copy this file to .env and configure your variables
# ==============================================================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Database URL
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/kitobxon_ai
# For SQLite (local/testing): sqlite+aiosqlite:///./kitobxon.db
DATABASE_URL=sqlite+aiosqlite:///./kitobxon.db

# Redis URL (Optional for local dev, memory fallback is used if unavailable)
# Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Google Books API Key (Optional, works with free quota even without key)
GOOGLE_BOOKS_API_KEY=

# AI Analysis Configuration
# AI_PROVIDER: gemini | openai | mock (defaults to mock/metadata heuristic if key is empty)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Telegram IDs of Super Administrators (comma-separated integers)
# Example: 123456789,987654321
ADMIN_TELEGRAM_IDS=

# Admin Web Panel Session & JWT Secret
ADMIN_SESSION_SECRET=change-this-to-a-very-secure-random-secret-key-in-production

# Admin Web Panel Host & Port
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8000

# Public Base URL (for webhook or admin panel links)
PUBLIC_BASE_URL=http://localhost:8000

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
